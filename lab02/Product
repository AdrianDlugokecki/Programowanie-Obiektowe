public class Product {
    String name;
    double price;

    public Product(String name, double price) {
        this.name = name;
        this.price = price;
    }

    public void show() {
        System.out.println(name + ": " + price);
    }

    public static void main(String[] args) {
        Product product = new Product("Monitor", 1200);
        product.show();
    }
}

