public class Car {
    String brand;
    String model;
    int productionYear;
    double mileage;

    public Car() {
        this("null", "null", 0, 0.0);
    }

    public Car(String brand, String model) {
        this(brand, model, 0, 0.0);
    }

    public Car(String brand, String model, int productionYear, double mileage) {
        this.brand = brand;
        this.model = model;
        this.productionYear = productionYear;
        this.mileage = mileage;
    }
    public Car(Car other) {
        this(other.brand, other.model, other.productionYear, other.mileage);
    }

    public void drive(double distance) {
        if (distance > 0) {
            this.mileage += distance;
        }
    }

    public void showInformation() {
        System.out.println(brand + " " + model + " " + productionYear + " " + mileage);
    }

    public static void main(String[] args) {
        Car auto1 = new Car("Toyota", "Corolla", 2020, 50000);
        auto1.drive(150.5);
        auto1.showInformation();
        Car copy = new Car(auto1);
        copy.mileage = 60000;
        auto1.showInformation();
        copy.showInformation();
    }
}
